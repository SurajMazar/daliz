{
  "name": "@daliz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env --watch-path=dist --enable-source-maps dist/main.js",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:worker": "node --env-file-if-exists=../../.env --watch-path=dist --enable-source-maps dist/worker.js",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "db:generate:platform": "drizzle-kit generate --config drizzle.platform.config.ts",
    "db:generate:tenant": "drizzle-kit generate --config drizzle.tenant.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --enable-source-maps dist/cli/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env --enable-source-maps dist/cli/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:transpile": "swc src -d dist --strip-leading-paths --config-file .swcrc"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@daliz/shared": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.1.0",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.8",
    "colorthief": "^3.5.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.1",
    "nestjs-pino": "^5.2.0",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  }
}
