# Daliz local development configuration.
# Copy to .env and adjust. Never commit .env. In production these values come from a secret
# manager (see docs/DEPLOYMENT.md) and every *_dev_only value below must be replaced.

NODE_ENV=development
LOG_LEVEL=debug

# --- HTTP -------------------------------------------------------------------
API_PORT=3000
# Public origin of the web app. Used for CORS, CSRF origin checks and links in emails.
APP_BASE_URL=http://localhost:5173
# Additional allowed browser origins (comma separated), e.g. tenant subdomains in dev.
CORS_EXTRA_ORIGINS=http://acme.localhost:5173,http://globex.localhost:5173
# Base domain for tenant subdomains (acme.<TENANT_BASE_DOMAIN>).
TENANT_BASE_DOMAIN=localhost
# Hosts allowed to serve the platform (Super Admin) API. Empty = any host.
PLATFORM_ADMIN_HOSTS=
# Number of reverse proxies in front of the API whose X-Forwarded-* headers are trusted.
TRUST_PROXY_HOPS=1

# --- Platform database ---------------------------------------------------------
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=55432
PLATFORM_DB_NAME=daliz_platform
PLATFORM_DB_USER=daliz_platform
PLATFORM_DB_PASSWORD=daliz_platform_dev_only
PLATFORM_DB_POOL_MAX=10

# --- Tenant databases ----------------------------------------------------------
# The provisioner role creates tenant databases and roles. It needs CREATEDB and CREATEROLE,
# and must NOT be a superuser. The API never uses it for request handling.
PROVISIONER_DB_USER=daliz_provisioner
PROVISIONER_DB_PASSWORD=daliz_provisioner_dev_only
# Host/port tenant databases live on (a single cluster in dev; can be sharded later).
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=55432
TENANT_DB_PREFIX=daliz_tenant_
# Connection manager limits (see docs/TENANCY.md).
TENANT_POOL_MAX_CONNECTIONS=5
TENANT_POOL_MAX_POOLS=200
TENANT_POOL_IDLE_TTL_SECONDS=300
TENANT_DB_STATEMENT_TIMEOUT_MS=15000
# Grace period between scheduling a tenant decommission and dropping its database.
TENANT_DECOMMISSION_GRACE_HOURS=72

# --- Postgres superuser (compose only; the app never uses it) ------------------------
POSTGRES_SUPERUSER=daliz_root
POSTGRES_SUPERUSER_PASSWORD=daliz_root_dev_only

# --- Redis -----------------------------------------------------------------------
REDIS_URL=redis://:daliz_redis_dev_only@127.0.0.1:56379/0
REDIS_PASSWORD=daliz_redis_dev_only

# --- Secrets -----------------------------------------------------------------------
# 32-byte keys, base64. Generate with: openssl rand -base64 32
# ENCRYPTION_KEYS is a comma-separated keyring "id:base64key"; the first key encrypts,
# all keys decrypt, which allows rotation.
ENCRYPTION_KEYS=k1:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=
# HMAC key for session/token hashing and signed asset URLs.
TOKEN_HMAC_KEY=ZGV2LW9ubHktaG1hYy1rZXktZm9yLWRhbGl6LXRva2Vucw==

# --- Sessions ------------------------------------------------------------------------
SESSION_COOKIE_NAME=daliz_sid
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=168
STEP_UP_MINUTES=10

# --- Object storage (S3 compatible; MinIO in dev) ----------------------------------------
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=daliz-dev
S3_ACCESS_KEY_ID=daliz_minio
S3_SECRET_ACCESS_KEY=daliz_minio_dev_only
S3_FORCE_PATH_STYLE=true

# --- Files ---------------------------------------------------------------------------
FILE_MAX_UPLOAD_MB=50
# clamd for malware scanning (docker compose --profile av up). Unset = built-in heuristic
# scanner, which is only suitable for development.
CLAMAV_HOST=
CLAMAV_PORT=53310

# --- Web Push (VAPID) ---------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys. Unset = push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@daliz.local

# --- Email (Mailpit in dev: http://127.0.0.1:58025) -----------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Daliz <no-reply@daliz.local>"

# --- Seed data -------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL=superadmin@daliz.local
SEED_SUPERADMIN_PASSWORD=Daliz-Dev-Super-2026!
SEED_DEFAULT_PASSWORD=Daliz-Dev-User-2026!
